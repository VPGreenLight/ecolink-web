# ==============================================================================
# ECOLINK WEB — MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Hướng dẫn cho thành viên nhóm:
#   1. Nhân bản file này thành `.env.local` (file `.env.local` đã được .gitignore bỏ qua).
#   2. Điền giá trị key cá nhân vào `.env.local`, KHÔNG điền key thật vào `.env.example`.
# ==============================================================================

# 1. CARTO Basemaps Public API Key (hiển thị nền bản đồ tương tác CARTO Voyager tại /map)
#    - Xin key miễn phí (không cần tạo tài khoản/thẻ): https://carto.com/basemaps/apikey
#    - Nếu tạm để trống khi dev cục bộ, ứng dụng sẽ dự phòng sang OpenStreetMap Standard Tile.
VITE_CARTO_API_KEY=

# 2. Đích chuyển tiếp Vite Proxy cho `/api` và `/hubs` trong `vite.config.ts`
#    - Để trống để dùng mặc định `http://localhost:5000`
VITE_API_PROXY_TARGET=

# 3. URL gốc của EcoLink Backend API khi triển khai tách rời Frontend tĩnh
#    - Để trống khi chạy dev cục bộ hoặc Cloudflare Quick Tunnel (tự đi qua proxy `/api`)
VITE_API_BASE_URL=

